# ============================================================
# Lab 4 AI Assistant + MCP server settings
# Copy to .env and edit:   copy .env.example .env
# .env holds secrets: never commit it.
# ============================================================

# ---------- LLM providers (switchable in the assistant UI) ----------
# Which providers appear in the UI dropdown
LLM_PROVIDERS=ollama,openai
LLM_DEFAULT_PROVIDER=ollama
LLM_DEFAULT_MODEL=qwen2.5:7b

# Free, local: install Ollama, then:  ollama pull llama3.2   and   ollama pull qwen2.5:7b
#   Running the assistant directly on Windows:  http://localhost:11434/v1
#   Running it in Kubernetes (Docker Desktop):  k8s-ai.yaml overrides this with host.docker.internal
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODELS=qwen2.5:7b,llama3.2
OLLAMA_TEMPERATURE=0.1

# Paid: an API key from https://platform.openai.com/api-keys with billing enabled.
# A ChatGPT Plus/Pro subscription does NOT include API access.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4.1-mini,gpt-5-mini

LLM_TIMEOUT_SECONDS=300

# ---------- Embeddings + RAG (used by the product API) ----------
# ollama (free):  ollama pull nomic-embed-text      openai (paid): text-embedding-3-small      none: keyword search only
# Changing the model? Run  POST /knowledge/sync  (or /knowledge/reembed) to re-embed every chunk.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Passages the assistant's RAG mode puts into the prompt
RAG_TOP_K=5

# ---------- Agent ----------
AGENT_MAX_STEPS=6
# Tools that pause for human approval before they run
APPROVAL_TOOLS=create_product,update_product,delete_product,upload_product_attachment,delete_attachment

# ---------- MCP connection used by the assistant (the MCP host) ----------
# stdio            -> the assistant starts the MCP server as a child process
# streamable_http  -> the assistant connects to MCP_URL
MCP_TRANSPORT=stdio
#   Local, no Docker:  http://localhost:8200/mcp      Kubernetes (from Windows): http://mcp.platform.local/mcp
#   (k8s-ai.yaml sets the in-cluster value itself)
MCP_URL=http://localhost:8200/mcp

# ---------- MCP server -> product API ----------
#   Local, no Docker (uvicorn app.main:app --port 8121):  http://localhost:8121
#   API running in Kubernetes:                            http://platform.local
#   (k8s-ai.yaml sets the in-cluster values itself)
API_BASE_URL=http://localhost:8121
PUBLIC_API_URL=http://localhost:8121
MAX_UPLOAD_MB=20
